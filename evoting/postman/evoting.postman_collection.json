{
  "info": {
    "name": "Secure E-Voting (Person 2 modules)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "1. Sync eligibility (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/voter-authorization/sync/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "voter-authorization",
            "sync"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"election_id\": \"{{election_id}}\"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{admin_user}}"
            },
            {
              "key": "password",
              "value": "{{admin_pass}}"
            }
          ]
        }
      }
    },
    {
      "name": "2. Create Paillier election key (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/encryption/election-keys/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "encryption",
            "election-keys"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"election_id\": \"{{election_id}}\"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{admin_user}}"
            },
            {
              "key": "password",
              "value": "{{admin_pass}}"
            }
          ]
        }
      }
    },
    {
      "name": "3. Generate QR token (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/qr/generate/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "qr",
            "generate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"voter_id\": \"{{voter_id}}\",\n  \"election_id\": \"{{election_id}}\"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{admin_user}}"
            },
            {
              "key": "password",
              "value": "{{admin_pass}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('qr_token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Validate QR (public, non-consuming)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/qr/validate/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "qr",
            "validate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{qr_token}}\"\n}"
        }
      }
    },
    {
      "name": "5. DEV keypair (demo only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/anonymous-auth/dev/keypair/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "anonymous-auth",
            "dev",
            "keypair"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"election_id\": \"{{election_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=pm.response.json();",
              "pm.collectionVariables.set('private_key', j.private_key);",
              "pm.collectionVariables.set('public_key', j.public_key);",
              "pm.collectionVariables.set('pop_R', j.possession_proof.R);",
              "pm.collectionVariables.set('pop_s', j.possession_proof.s);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Register credential (consumes QR)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/anonymous-auth/credentials/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "anonymous-auth",
            "credentials"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{qr_token}}\",\n  \"public_key\": \"{{public_key}}\",\n  \"possession_proof\": {\n    \"R\": \"{{pop_R}}\",\n    \"s\": \"{{pop_s}}\"\n  }\n}"
        }
      }
    },
    {
      "name": "7. Ring",
