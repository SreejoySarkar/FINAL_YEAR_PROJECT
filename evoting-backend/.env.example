SECRET_KEY=replace-with-a-new-random-django-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=evoting_db
DB_USER=replace-with-your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

QR_SIGNING_KEY=replace-with-a-separate-random-signing-key
QR_TOKEN_SALT=evoting-qr-token

ADMIN_OTP_SALT=admin-otp-session
ADMIN_OTP_VALID_MINUTES=5
ADMIN_OTP_MAX_ATTEMPTS=5

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=
MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@evoting.local

EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=replace-with-your-email-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
