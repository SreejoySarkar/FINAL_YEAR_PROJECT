# Person 1 integration. Use their real "app_label.ModelName" values when ready.
USE_P1_STUB=True
P1_VOTER_MODEL=p1_stub.Voter
P1_ELECTION_MODEL=p1_stub.Election
P1_CANDIDATE_MODEL=p1_stub.Candidate
# Crypto
PAILLIER_KEY_BITS=2048
