QR_TOKEN_TTL_SECONDS=900
MIN_RING_SIZE=3
ENABLE_DEMO_ENDPOINTS=False
# Person 2 voting security settings
BALLOT_MASTER_KEY=replace-with-base64-32-byte-key
INTEGRITY_KEY=replace-with-a-long-random-secret
VOTE_THROTTLE=120/min
