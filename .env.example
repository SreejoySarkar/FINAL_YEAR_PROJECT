DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
QR_SIGNING_KEY=change-me-too
PSEUDONYM_SECRET=change-me-three
# PostgreSQL (shared database provisioned by Person 1)
DB_NAME=evoting
DB_USER=evoting
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=localhost
